// Italian (IT) - ISO laptop layout. \ | on TLDE, ù § on the BKSL key.
// Laptop layer (no AltGr in UEFI; hold Fn if your F-row is media-first):
//   F1 `  F2 ~  F3 \  F4 |  F5 @  F6 #  F7 [  F8 ]  F9 {  INS }  F11 <  F12 >
// F1/F2/F10 keep their help/save/exit meaning inside 'edit'.
name = "Italian (IT) laptop"
key <TLDE> { [ backslash, bar ] };
key <AE02> { [ 2, quotedbl ] };
key <AE03> { [ 3, sterling ] };
key <AE06> { [ 6, ampersand ] };
key <AE07> { [ 7, slash ] };
key <AE08> { [ 8, parenleft ] };
key <AE09> { [ 9, parenright ] };
key <AE10> { [ 0, equal ] };
key <AE11> { [ apostrophe, question ] };
key <AE12> { [ U+EC, asciicircum ] };
key <AD11> { [ U+E8, U+E9 ] };
key <AD12> { [ plus, asterisk ] };
key <AC10> { [ U+F2, U+E7 ] };
key <AC11> { [ U+E0, degree ] };
key <AB08> { [ comma, semicolon ] };
key <AB09> { [ period, colon ] };
key <AB10> { [ minus, underscore ] };
key <BKSL> { [ U+F9, section ] };
F1 = `
F2 = ~
F3 = \\
F4 = |
F5 = @
F6 = #
F7 = [
F8 = ]
F9 = {
INS = }
F11 = <
F12 = >
