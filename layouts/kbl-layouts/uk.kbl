// English (UK) - ISO laptop layout.
// Laptop layer: UEFI can't see AltGr or tell the ISO \ key from #, so common
// symbols live on the F-row (hold Fn if your F-row is media-first).
//   F1 `  F2 ~  F3 \  F4 |  F5 @  F6 #  F7 [  F8 ]  F9 {  INS }  F11 <  F12 >
// F1/F2/F10 keep their help/save/exit meaning inside 'edit'.
name = "English (UK) laptop"
key <TLDE> { [ grave, notsign ] };
key <AE02> { [ 2, quotedbl ] };
key <AE03> { [ 3, sterling ] };
key <AC11> { [ apostrophe, at ] };
key <BKSL> { [ numbersign, asciitilde ] };
F1 = `
F2 = ~
F3 = \\
F4 = |
F5 = @
F6 = #
F7 = [
F8 = ]
F9 = {
INS = }
F11 = <
F12 = >
