// German (QWERTZ) - ISO laptop layout.
// Laptop layer (no AltGr in UEFI; hold Fn if your F-row is media-first):
//   F1 `  F2 ~  F3 \  F4 |  F5 @  F6 #  F7 [  F8 ]  F9 {  INS }  F11 <  F12 >
// F1/F2/F10 keep their help/save/exit meaning inside 'edit'.
name = "German (DE) laptop"
key <TLDE> { [ asciicircum, degree ] };
key <AE02> { [ 2, quotedbl ] };
key <AE03> { [ 3, section ] };
key <AE06> { [ 6, ampersand ] };
key <AE07> { [ 7, slash ] };
key <AE08> { [ 8, parenleft ] };
key <AE09> { [ 9, parenright ] };
key <AE10> { [ 0, equal ] };
key <AE11> { [ ssharp, question ] };
key <AE12> { [ U+B4, grave ] };
key <AD06> { [ z, Z ] };
key <AD11> { [ udiaeresis, Udiaeresis ] };
key <AD12> { [ plus, asterisk ] };
key <AC10> { [ odiaeresis, Odiaeresis ] };
key <AC11> { [ adiaeresis, Adiaeresis ] };
key <AB01> { [ y, Y ] };
key <AB08> { [ comma, semicolon ] };
key <AB09> { [ period, colon ] };
key <AB10> { [ minus, underscore ] };
key <BKSL> { [ numbersign, apostrophe ] };
F1 = `
F2 = ~
F3 = \\
F4 = |
F5 = @
F6 = #
F7 = [
F8 = ]
F9 = {
INS = }
F11 = <
F12 = >
